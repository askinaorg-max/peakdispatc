<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>PeakDispatch – Premium Truck Dispatch Services</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="page">
    <header class="nav">
      <div class="nav-inner">
        <div class="nav-left">
          <div class="logo-wrap">
            <img src="/images/peakdispatch-logo.png" alt="PeakDispatch logo" />
          </div>
          <div class="brand-text">
            <span>PeakDispatch</span>
            <span>Dispatch at Peak Performance</span>
          </div>
        </div>
        <nav class="nav-links">
          <a href="#" data-section-link="about">About</a>
          <a href="#" data-section-link="services">Services</a>
          <a href="#" data-section-link="how-it-works">How it works</a>
          <a href="#" data-section-link="contact">Contact</a>
        </nav>
        <div class="nav-cta">
          <a href="/join" data-open="join"class="btn btn-outline nav-cta-desktop">Join as Carrier</a>
          <a href="/join" data-open="join"class="btn btn-primary nav-cta-desktop">Get Started</a>
          <a href="/call" class="btn btn-outline nav-cta-desktop">Video Call</a>
          <button class="nav-toggle" type="button" id="navToggle" aria-label="Toggle navigation">
            <span class="nav-toggle-label">Menu</span>
          </button>
        </div>
      </div>
      <div class="nav-mobile" id="navMobile">
        <div class="nav-mobile-inner">
          <a href="#" data-section-link="about" class="nav-mobile-link">About</a>
          <a href="#" data-section-link="services" class="nav-mobile-link">Services</a>
          <a href="#" data-section-link="how-it-works" class="nav-mobile-link">How it works</a>
          <a href="#" data-section-link="contact" class="nav-mobile-link">Contact</a>
          <a href="/join" data-open="join"class="btn btn-primary nav-mobile-cta">Join as Carrier</a>
          <a href="/call" class="btn btn-outline nav-mobile-cta">Video Call</a>
        </div>
      </div>
    </header>

    <!-- Loader overlay -->
    <div id="section-loader" class="loader-overlay hidden">
      <div class="loader-inner">
        <div class="loader-logo">
          <img src="/images/peakdispatch-logo.png" alt="PeakDispatch logo loading" />
          <div class="loader-ring"></div>
        </div>
      </div>
    </div>

    <main>
	<section class="hero hero--image">
	<div class="topDaily" aria-label="Top Daily">
  <h3>Top Daily <br><span id="dailyDate"><%= topDailyDate %></span></h3>

  <% const order = ['Van','Reefer','Flatbed']; %>
  <% order.forEach(function(type){ const d = topByType[type]; %>
    <div class="category" data-driver-id="<%= d ? d.id : '' %>">
      <h4><%= type %></h4>
      <% if (d) { %>
        <p><b>Name:</b> <%= d.name %></p>
        <p><b>Miles:</b> <%= d.miles %> mi</p>
        <p><b>RPM:</b> <%= d.rpm %></p>
        <p><b>Route:</b> <%= d.route %></p>

        <div class="topdaily-actions">
          <button class="btn btn-outline btn-sm js-open-comments" type="button">💬 Comments</button>
          <button class="btn btn-primary btn-sm js-open-comment-form" type="button">✍️ Leave a comment</button>
          <button class="btn btn-ghost btn-sm js-open-history" type="button" data-type="<%= type %>">📅 History</button>
        </div>
      <% } else { %>
        <p style="opacity:0.8;">No driver selected yet.</p>
      <% } %>
    </div>
  <% }); %>
</div>

<!-- Comments modal -->
<div class="modal hidden" id="commentsModal" role="dialog" aria-modal="true">
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-card">
    <div class="modal-head">
      <h3 id="commentsTitle">Comments</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Close">×</button>
    </div>
    <div class="modal-body">
      <div id="commentsList" class="comments-list"></div>

      <form id="commentForm" class="comment-form">
        <h4 style="margin:1rem 0 0.5rem;">Leave a comment</h4>
        <input type="hidden" id="commentDriverId" name="driverId" />
        <div class="form-grid">
          <div>
            <label class="label" for="commentName">Name</label>
            <input class="input" id="commentName" name="name" placeholder="Your name (optional)" />
          </div>
          <div>
            <label class="label" for="commentRating">Rating (1–9)</label>
            <input class="input" id="commentRating" name="rating" type="number" min="1" max="9" value="9" />
          </div>
          <div class="form-grid-full">
            <label class="label" for="commentText">Comment</label>
            <textarea class="textarea" id="commentText" name="text" placeholder="Write your comment..." required></textarea>
          </div>
        </div>
        <div style="display:flex; gap:0.6rem; align-items:center; margin-top:0.8rem;">
          <button class="btn btn-primary" type="submit">Submit</button>
          <span id="commentStatus" style="font-size:0.85rem; opacity:0.85;"></span>
        </div>
        <p style="font-size:0.8rem; opacity:0.8; margin-top:0.6rem;">
          Comments are published after admin approval.
        </p>
      </form>
    </div>
  </div>
</div>


<!-- History modal -->
<div class="modal hidden" id="historyModal" role="dialog" aria-modal="true">
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-card modal-card--wide">
    <div class="modal-head">
      <h3 id="historyTitle">📅 Driver History</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Close">×</button>
    </div>

    <div class="modal-body">
      <p class="muted" id="historySubtitle" style="margin-top:0;">Last 15 days</p>
      <div id="historyList" class="history-list">
        <div class="muted">Loading…</div>
      </div>
    </div>
  </div>
</div>

<div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-overlay"></div>

  <div class="hero-content" data-aos="fade-up">
    <h1>Premium Dispatch for Carriers & Fleets</h1>
    <p>Higher RPM. Lower downtime. Clear reporting.</p>
    <div class="hero-cta">
      <a href="/join" data-open="join"class="btn btn-primary">Get Free Strategy Call</a>
<a href="/#services" class="btn btn-outline no-popup">See Services</a>
    </div>
  </div>
</section>


 

      <section id="about" class="section dynamic-section pd-reveal" data-section="about">
        <div class="section-inner">
          <div class="section-header">
            <div>
              <div class="section-kicker">About PeakDispatch</div>
              <h2 class="section-title pd-reveal"><%= content.aboutTitle %></h2>
            </div>
            <p class="section-description"><%= content.aboutText %></p>
          </div>

          <div class="about-grid">
            <div class="about-block">
              <h3 class="card-title">For owner-operators</h3>
              <p class="card-text">
                Keep your truck loaded with premium freight while we negotiate rates, handle back-office work
                and watch the market for you.
              </p>
              <ul class="bullet-list">
                <li>Hands-off dispatch while you stay in control of lanes and schedule.</li>
                <li>Transparent pricing and no long-term lock-in.</li>
                <li>Weekly performance reports with RPM, lane and broker insights.</li>
              </ul>
            </div>
            <div class="about-block">
              <h3 class="card-title">For growing fleets</h3>
              <p class="card-text">
                Use PeakDispatch as a strategic control room for your 5–50+ truck operation.
              </p>
              <ul class="bullet-list">
                <li>Centralized planning for multi-truck operations and dedicated lanes.</li>
                <li>Lane and capacity recommendations based on real-time load board data.</li>
                <li>Optional executive recap calls to review numbers and set weekly focus.</li>
              </ul>
            </div>
            <div class="about-note">
              <div class="badge-pill">Free strategy call</div>
              <p>
                Every new carrier receives a <strong>complimentary 30-minute dispatch strategy session</strong> —
                no obligation, just practical advice based on your numbers and lanes.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="services" class="section dynamic-section pd-reveal" data-section="services">
        <div class="section-inner">
          <div class="section-header">
            <div>
              <div class="section-kicker">Services</div>
              <h2 class="section-title pd-reveal"><%= content.servicesTitle %></h2>
            </div>
            <p class="section-description">
              From solo owner-operators to growing fleets, we plug into your operation and keep your trucks
              moving with profitable loads and clear communication.
            </p>
          </div>

          <div class="card-grid">
            <% content.services.forEach(function(service) { %>
              <article class="card">
                <h3 class="card-title"><%= service.title %></h3>
                <p class="card-text"><%= service.text %></p>
              </article>
            <% }) %>
          </div>

          <div class="services-extra">
            <div>
              <h3 class="card-title">Free consultation, real numbers</h3>
              <p class="card-text">
                Our consultations and discovery calls are <strong>100% free</strong>.
                We walk through your current lanes, RPM and utilization and share
                what similar carriers are doing to reach the next revenue band.
              </p>
            </div>
            <div>
              <h3 class="card-title">Exclusive market insight</h3>
              <p class="card-text">
                We aggregate live data from multiple load boards and direct shipper relationships.
                That means you see opportunities and lanes that are often invisible to the open market.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="how-it-works" class="section dynamic-section pd-reveal" data-section="how-it-works">
        <div class="section-inner">
          <div class="section-header">
            <div>
              <div class="section-kicker">Process</div>
              <h2 class="section-title pd-reveal">How working with PeakDispatch feels</h2>
            </div>
            <p class="section-description">
              We keep things simple, transparent and structured so you always know what is happening with
              your trucks and your revenue.
            </p>
          </div>

          <div class="card-grid">
            <article class="card">
              <h3 class="card-title">01 — Discovery & fit</h3>
              <p class="card-text">
                On a short discovery call we review your current operation, targets and lanes.
                You receive honest feedback on whether PeakDispatch can realistically move the needle for you.
              </p>
            </article>
            <article class="card">
              <h3 class="card-title">02 — Onboarding & setup</h3>
              <p class="card-text">
                We configure communication channels, carrier packets, preferred lanes and escalation rules.
                Larger fleets can add owner, ops and finance stakeholders to a shared reporting space.
              </p>
            </article>
            <article class="card">
              <h3 class="card-title">03 — Daily dispatch & reviews</h3>
              <p class="card-text">
                Our dispatchers keep your trucks loaded while you get <strong>weekly executive recaps</strong>
                with RPM, lane and margin views plus concrete actions for the upcoming week.
              </p>
            </article>
          </div>
        </div>
      </section>
	          
      </section>
	  <section id="who-we-serve" class="section dynamic-section pd-reveal" data-section="who-we-serve">
  <h2>Who We Serve</h2>
  <div class="grid-3">
    <article class="card">
      <h3>Owner-Operators</h3>
      <ul>
        <li>Premium freight & rate negotiation</li>
        <li>Back-office paperwork done for you</li>
        <li>Weekly RPM performance reports</li>
      </ul>
    </article>
    <article class="card">
      <h3>Small Fleets (2–10)</h3>
      <ul>
        <li>Centralized planning & preferred lanes</li>
        <li>Dedicated dispatcher coverage</li>
        <li>Broker & shipper relationship management</li>
      </ul>
    </article>
    <article class="card">
      <h3>Growing Fleets (10+)</h3>
      <ul>
        <li>Executive recaps & KPI dashboards</li>
        <li>Multi-truck utilization & driver scheduling</li>
        <li>Direct shipper opportunities</li>
      </ul>
    </article>
  </div>
</section>
      <section id="contact" class="section dynamic-section pd-reveal" data-section="contact">
        <div class="section-inner">
          <div class="cta-banner">
            <div class="cta-banner-text">
              <h2 class="cta-banner-title"><%= content.ctaBannerTitle %></h2>
              <p><%= content.ctaBannerText %></p>
              <p style="margin-top:0.7rem;font-size:0.86rem;">
                Consultations and intro calls are <strong>completely free</strong>.
                We focus on sharing practical, exclusive market insight so that even
                if we do not work together, the conversation is still valuable for your business.
              </p>
            </div>
            <div class="cta-actions">
              <a href="/join" data-open="join"class="btn btn-primary">Request free strategy call</a>
              <a href="/join" data-open="join"class="btn btn-outline">Join as Carrier</a>
            </div>
          </div>
        </div>
      </section>


	  <a href="/join" data-open="join"class="cta-float">Free Strategy Call</a>

    </main>

    <footer class="footer">
      <%= footerText %>
    </footer>
  </div>
  <script src="/js/main.js"></script>

<!-- JOIN AS DRIVER POPUP -->
<div id="joinModal" class="join-modal">
  <div class="join-modal-content">
    <span class="join-close" id="joinClose">&times;</span>
    <h2>Join as Driver</h2>

    <div class="join-options">

      <div class="join-box">
        <h3>Company</h3>
        <p>Waiting for rates.</p>
        <button class="btn btn-primary join-apply" data-type="company">Apply</button>
      </div>

      <div class="join-box">
        <h3>List to Purchase</h3>
        <p>Negotiating..</p>
        <button class="btn btn-primary join-apply" data-type="purchase">Apply</button>
      </div>

      <div class="join-box">
        <h3>Owner Operator</h3>
        <p>Sign up to 10,000 USD Bonus</p>
        <button class="btn btn-primary join-apply" data-type="owner">Apply</button>
      </div>

    </div>
  </div>
</div>
<!-- ONBOARDING PHONE POPUP -->
<div id="phoneModal" class="phone-modal">
  <div class="phone-modal-content">
    <span id="phoneClose" class="phone-close">&times;</span>

    <div class="phone-modal-logo"></div>

    <h2>Free Strategy Call</h2>
    <p>
      Leave your phone number and someone from <strong>PeakDispatch</strong>  
      will reach out shortly.  
      The call and consultation are completely <strong>free</strong>.
    </p>

    <input type="text" id="phoneInput" placeholder="Your phone number" />

    <button id="phoneSubmit" class="btn btn-primary" style="width:100%;">
      Submit Number
    </button>

    <a id="continueSite" class="continue-link">continue to peakdispatch.net</a>
  </div>
</div>
<!-- Floating Video Call Button (Mobile) -->
<a href="/call" class="floating-btn video-btn">🎥 Video Call</a>


</body>
</html>
